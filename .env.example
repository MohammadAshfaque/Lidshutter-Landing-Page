# Copy to .env for local testing, and add the same names in Vercel → Project → Settings → Environment Variables.
# Never commit the real values.

# "test" while you try it out, "live" when you launch. Anything other than "live" uses Dodo's test mode.
DODO_ENV=test

# Dodo dashboard → Developer → API Keys (use the test-mode key while DODO_ENV=test)
DODO_API_KEY=

# Dodo dashboard → Developer → Webhooks → your endpoint → signing secret (starts with whsec_)
DODO_WEBHOOK_SECRET=

# One product per launch price (1 Mac each): $1.99, $2.99, $3.99, $4.99
DODO_PRODUCT_LAUNCH_1=
DODO_PRODUCT_LAUNCH_2=
DODO_PRODUCT_LAUNCH_3=
DODO_PRODUCT_LAUNCH_4=

# Regular products by number of Macs. MACS_1 is the $4.99 one-Mac product used after the launch slots sell out.
DODO_PRODUCT_MACS_1=
DODO_PRODUCT_MACS_2=
DODO_PRODUCT_MACS_3=
DODO_PRODUCT_MACS_4=
DODO_PRODUCT_MACS_5=
DODO_PRODUCT_MACS_6=
DODO_PRODUCT_MACS_7=
DODO_PRODUCT_MACS_8=
DODO_PRODUCT_MACS_9=
DODO_PRODUCT_MACS_10=

# Optional: licenses you sold some other way, so the launch price counts them too.
SOLD_OFFSET=0

# Upstash Redis (free): holds the "launch slots sold" count and the live sounds counter.
# Vercel → Storage → Upstash Redis fills these in for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Support form: emails the message to support@lidshutter.com (resend.com, free tier).
RESEND_API_KEY=
# After you verify your domain in Resend, e.g. LidShutter <support@lidshutter.com>
FEEDBACK_FROM=
