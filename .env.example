# Copy to .env for local testing, and add the same names in Vercel → Project → Settings → Environment Variables.
# Never commit the real values. Step by step: POLAR-SETUP.md

# "sandbox" while you try it out, "live" when you launch. Anything other than "live" uses Polar's sandbox.
POLAR_ENV=sandbox

# Polar → Settings → Developers → New Access Token (Organization Access Token).
# Scopes: checkouts:write, checkouts:read, customer_sessions:write, license_keys:write
# Sandbox and live have separate tokens.
POLAR_ACCESS_TOKEN=

# Polar → Settings → Webhooks → your endpoint → the secret you set (or the one Polar made)
POLAR_WEBHOOK_SECRET=

# The ONE Polar product everything is sold through (its ID is a UUID). The site sets the price and, for Mac packs,
# the number of Macs for each sale, so there is nothing else to create in Polar.
POLAR_PRODUCT_ID=

# Optional: licenses you sold some other way, so the launch price counts them too.
SOLD_OFFSET=0

# Upstash Redis (free): holds the "launch slots sold" count and the live sounds counter.
# Vercel → Storage → Upstash Redis fills these in for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Support form: emails the message to support@lidshutter.com (resend.com, free tier).
RESEND_API_KEY=
# After you verify your domain in Resend, e.g. LidShutter <support@lidshutter.com>
FEEDBACK_FROM=
