---
// Where Polar sends people after they pay (with ?checkout_id=… in the address). This page asks our server for
// that purchase's license key (/api/license-key) and shows it with a copy button and the steps to switch
// LidShutter on. If the key can't be fetched, it points to the customer portal, where the key always lives.
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { site } from '../data/site';
---

<Base title="Thank you" description="Your LidShutter license key and how to activate it." home={false} noindex>
  <Prose eyebrow="Thank you" title="You’re all set. Here’s your key.">
    <div class="key-card" data-key-card hidden>
      <p class="key-label" data-key-label>Your license key</p>
      <ul class="keys" data-keys></ul>
      <p class="key-note">
        Keep it somewhere safe. You can always find it again in your{' '}
        <a data-portal href={site.portalUrl} rel="noopener">customer portal</a> (sign in with the email you used to buy).
      </p>
    </div>

    <p class="callout" data-waiting>Getting your key ready…</p>

    <p class="callout" data-no-key hidden>
      We couldn’t show your key here, but it’s safe. Open your{' '}
      <a data-portal href={site.portalUrl} rel="noopener">customer portal</a> and sign in with the email you used to buy,
      and it’s there. Can’t find it? Write to{' '}
      <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a> and we’ll sort it out.
    </p>

    <h2>Switch LidShutter on</h2>
    <ol class="steps">
      <li>
        <strong>Download LidShutter</strong> and drag it to your Applications folder.
        <a class="dl" href={site.downloadUrl}>Download for Mac</a>
      </li>
      <li>Open it, then click the <strong>menu bar icon</strong> and choose <strong>Open Dashboard → License</strong>.</li>
      <li>Paste your key and press <strong>Activate</strong>. Your lid sounds start right away.</li>
    </ol>

    <h2>Good to know</h2>
    <ul>
      <li>One key activates one Mac. A multi-Mac pack has one key that covers all the Macs you bought.</li>
      <li>Activating needs the internet once. After that, LidShutter works offline, and tells you when a new version is ready.</li>
      <li>Not for you? You have 7 days to ask for a full refund: see the <a href="/refund">refund policy</a>.</li>
      <li>Getting a new Mac? Open <strong>License → Deactivate this Mac</strong> first, then use the key on the new one.</li>
    </ul>
  </Prose>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const checkout = params.get('checkout_id') ?? '';

  const card = document.querySelector<HTMLElement>('[data-key-card]')!;
  const list = document.querySelector<HTMLUListElement>('[data-keys]')!;
  const noKey = document.querySelector<HTMLElement>('[data-no-key]')!;
  const waiting = document.querySelector<HTMLElement>('[data-waiting]')!;
  const label = document.querySelector<HTMLElement>('[data-key-label]')!;

  function showKeys(keys: string[]) {
    waiting.hidden = true;
    card.hidden = false;
    label.textContent = keys.length > 1 ? 'Your license keys' : 'Your license key';
    for (const key of keys) {
      const item = document.createElement('li');
      const code = document.createElement('code');
      code.textContent = key;
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = 'Copy';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(key);
          button.textContent = 'Copied ✓';
        } catch {
          // Clipboard blocked: select the key so ⌘C works.
          const range = document.createRange();
          range.selectNodeContents(code);
          getSelection()?.removeAllRanges();
          getSelection()?.addRange(range);
          button.textContent = 'Press ⌘C';
        }
        setTimeout(() => (button.textContent = 'Copy'), 2200);
      });
      item.append(code, button);
      list.append(item);
    }
  }

  function giveUp(portalUrl?: string) {
    waiting.hidden = true;
    noKey.hidden = false;
    if (portalUrl) document.querySelectorAll<HTMLAnchorElement>('[data-portal]').forEach((a) => (a.href = portalUrl));
  }

  // Polar makes the key a moment after the payment, so ask a few times.
  async function load() {
    for (let attempt = 0; attempt < 15; attempt++) {
      try {
        const res = await fetch(`/api/license-key?checkout=${encodeURIComponent(checkout)}`, { cache: 'no-store' });
        const data = (await res.json()) as { status: string; keys?: string[]; portalUrl?: string };
        if (data.status === 'ready' && data.keys?.length) {
          if (data.portalUrl) document.querySelectorAll<HTMLAnchorElement>('[data-portal]').forEach((a) => (a.href = data.portalUrl!));
          showKeys(data.keys);
          return;
        }
        if (data.status !== 'pending') return giveUp(data.portalUrl);
      } catch {
        return giveUp();
      }
      await new Promise((resolve) => setTimeout(resolve, 2500));
    }
    giveUp();
  }

  if (checkout) {
    load();
    // Don't leave the checkout address sitting in the address bar and browser history.
    history.replaceState(null, '', location.pathname);
  } else {
    giveUp();
  }
</script>

<style>
  .key-card {
    padding: 22px;
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: 0 0 0 1px var(--stroke) inset, var(--shadow);
  }

  .key-card[hidden],
  .callout[hidden] {
    display: none;
  }

  .key-label {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .keys {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .keys :global(li) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--bg);
    box-shadow: 0 0 0 1px var(--stroke-strong) inset;
  }

  .keys :global(code) {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    user-select: all;
  }

  .keys :global(button) {
    flex: none;
    padding: 7px 14px;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    color: var(--on-gold);
    background: var(--light);
    transition: transform 0.3s var(--spring);
  }

  .keys :global(button:hover) {
    transform: scale(1.06);
  }

  /* Narrow phones: a long key gets the full width, with Copy beneath it */
  @media (max-width: 420px) {
    .key-card {
      padding: 18px;
    }

    .keys :global(li) {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .keys :global(code) {
      font-size: 14px;
      text-align: center;
    }

    .keys :global(button) {
      padding: 10px 14px;
    }
  }

  .key-note {
    margin: 12px 0 0;
    font-size: 14px;
    color: var(--text-3);
  }

  .steps {
    margin: 0;
    padding-left: 22px;
    display: grid;
    gap: 12px;
  }

  .dl {
    display: inline-block;
    margin-left: 10px;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    color: var(--on-gold);
    background: var(--light);
  }
</style>
