---
import AppIcon from './AppIcon.astro';
import FaceField from './FaceField.astro';
import Icon from './Icon.astro';
import AppDashboard from './AppDashboard.astro';
import menubarSvg from '../data/menubar.svg?raw';

---

<section class="hero" data-hero aria-label="Introduction">
  <div class="pin" data-pin>
    <div class="glow" data-glow aria-hidden="true"></div>
    <FaceField variant="hero" />

    <div class="copy container" data-copy>
      <div class="top-pill">
        <p class="pill" data-intro-pill>
          <span class="pill-icon" set:html={menubarSvg} />
          A tiny menu bar app for MacBook
        </p>
        <a href="#roll" class="pill live-pill" data-live hidden>
          <span class="live-tag"><span class="live-dot" aria-hidden="true"></span>Live</span>
          <span class="live-text"><b class="odo" data-live-count>0</b> sounds played by visitors</span>
          <span class="live-cta">Hear one <Icon name="ArrowRight" /></span>
        </a>
      </div>
      <h1 class="display hero-title">
        Open your <span class="h-icon" aria-hidden="true"><AppIcon size={96} eager /></span> Mac<br />
        like you <span class="lit">open your shop.</span>
      </h1>
      <p class="lead">A tiny menu bar app that plays a shop shutter every time you lift the lid.</p>
      <div class="ctas">
        <button type="button" class="btn btn-primary" data-hear>
          <span class="hear-icon"><Icon name="Play" /></span>
          <span data-hear-label>Hear it</span>
        </button>
        <a href="#app" class="btn btn-secondary" data-app-pane="sounds">Explore sounds</a>
      </div>
    </div>

    <div class="stage" id="app" data-dark>
      <div class="rig" data-rig>
        <div class="floor" aria-hidden="true"></div>

        <!-- The lid: just the display, opening -->
        <div class="lid" data-lid>
          <div class="lid-front">
            <div class="bezel">
              <div class="screen" data-screen>
                <div class="wall" aria-hidden="true">
                  <div class="menubar">
                    <span class="mb-left"><b>LidShutter</b><span>File</span><span>Edit</span><span>View</span></span>
                    <span class="mb-right">
                      <span class="mb-glyph" set:html={menubarSvg} />
                      <span class="mb-dot"></span>
                      <span data-clock>9:41</span>
                    </span>
                  </div>
                  <div class="open-sign" data-open>
                    <AppIcon size={96} class="open-icon" />
                    <p class="open-title">Your shop is open</p>
                    <p class="open-chip">
                      <span class="eq"><i></i><i></i><i></i></span>
                      <span data-now-title>Rolling Shutter</span>
                    </p>
                  </div>
                </div>

                <!-- The Mac's desktop, with the app running on it -->
                <div class="desk-layer" data-desk-layer>
                  <AppDashboard />
                </div>

                <div class="shutter" data-shutter aria-hidden="true">
                  <div class="slats"></div>
                  <div class="sign">
                    <span>Sorry, we're</span>
                    <strong>closed</strong>
                  </div>
                  <div class="bar"></div>
                </div>
                <div class="screen-off" data-screen-off></div>
                <span class="notch-cam" aria-hidden="true"><i></i></span>
              </div>
            </div>
          </div>
          <div class="lid-edge"></div>
          <div class="lid-back" aria-hidden="true">
            <span class="lid-glyph" set:html={menubarSvg} />
          </div>
        </div>
      </div>
    </div>

    <a href="#how" class="hint" data-hint>
      <span>Scroll to open the lid</span>
      <Icon name="ChevronDown" />
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: -76px;
  }

  .pin {
    /* Open and seen from above, the laptop is about 1.75 × H tall */
    /* The lid is as wide as the screen allows, and 16:10 */
    --W: min(1500px, 94vw, calc((100svh - 70px) * 1.6 * 0.92));
    --H: calc(var(--W) * 0.625);
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Warm light filling the room as the lid opens */
  .glow {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: calc(var(--W) * 2.2);
    height: calc(var(--H) * 2.4);
    translate: -50% 0;
    /* Many soft stops so the glow fades without visible rings on white */
    background: radial-gradient(
      closest-side,
      rgb(255 194 71 / 0.3),
      rgb(255 186 64 / 0.22) 20%,
      rgb(255 176 56 / 0.14) 40%,
      rgb(255 168 48 / 0.07) 60%,
      rgb(255 160 40 / 0.025) 80%,
      transparent
    );
    opacity: 0;
    pointer-events: none;
  }

  .copy {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-top: clamp(170px, 22svh, 210px);
  }

  .top-pill {
    display: grid;
    justify-items: center;
    width: max-content;
    max-width: 100%;
    margin: 0 auto 22px;
  }

  .top-pill > * {
    grid-area: 1 / 1;
  }

  .pill.is-leaving {
    animation: pill-out 0.35s var(--ease-out) forwards;
  }

  @keyframes pill-out {
    to {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
  }

  .live-pill {
    position: relative;
    gap: 10px;
    padding: 5px 6px 5px 5px;
    color: var(--text-2);
    animation: pill-in 0.6s var(--spring) both;
    transition: box-shadow 0.25s, background-color 0.25s, transform 0.35s var(--spring);
  }

  .live-pill[hidden] {
    display: none;
  }

  .live-pill:hover {
    background: var(--fill-strong);
    box-shadow: 0 0 0 1px rgb(97 217 153 / 0.35) inset;
    transform: translateY(-1px);
  }

  .live-pill:active {
    transform: scale(0.97);
  }

  @keyframes pill-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
  }

  .live-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 10px 3px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #138a4b;
    background: rgb(97 217 153 / 0.2);
  }

  .live-text b {
    color: var(--text);
    font-weight: 700;
  }

  .live-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-left: 1px solid var(--stroke-strong);
    color: var(--text);
    font-weight: 500;
  }

  .live-cta :global(svg) {
    width: 14px;
    height: 14px;
    transition: transform 0.35s var(--spring);
  }

  .live-pill:hover .live-cta :global(svg) {
    transform: translateX(3px);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    background: #fff;
    box-shadow: 0 0 0 1px var(--stroke) inset, 0 6px 18px -10px rgb(0 0 0 / 0.18);
  }

  .pill-icon {
    color: var(--accent);
  }

  .pill-icon :global(svg) {
    width: 16px;
    height: 16px;
  }

  /* The app icon sitting inside the headline */
  .h-icon {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin: 0 0.04em;
    vertical-align: -0.1em;
    rotate: -10deg;
    transition: rotate 0.5s var(--spring), scale 0.5s var(--spring);
    animation: icon-bob 4s ease-in-out infinite;
  }

  .h-icon :global(img) {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0.08em 0.16em rgb(255 160 40 / 0.35));
  }

  .h-icon:hover {
    rotate: 8deg;
    scale: 1.12;
  }

  @keyframes icon-bob {
    50% {
      translate: 0 -0.05em;
    }
  }

  .hero-title {
    font-size: clamp(40px, 5.6vw, 72px);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .copy .lead {
    max-width: 620px;
    margin-top: 18px;
    font-size: clamp(16px, 1.5vw, 18px);
  }

  .ctas {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  /* MARK: Laptop: only the lid, opening. It is hinged at the bottom of the screen, which ends below the fold. */

  .stage {
    position: absolute;
    left: 0;
    right: 0;
    top: max(80svh, 500px);
    height: 0;
    perspective: 2600px;
    pointer-events: none;
  }

  .lid {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--H);
    transform-style: preserve-3d;
    transform-origin: bottom center;
    transform: rotateX(-90deg);
  }

  .rig {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--W);
    height: 0;
    margin-left: calc(var(--W) / -2);
    transform-style: preserve-3d;
    /* Looking down on the desk, like Apple's top-view product shots */
    transform: rotateX(-60deg);
  }

  /* Keyboard, speakers and trackpad, laid out like a 14-inch MacBook Pro seen from above */
  /* Touch ID: a plain key with a faint ring */
  /* Speaker grilles either side of the keyboard */
  /* The thin line of light escaping from under the closed lid */
  /* The lid's thickness, seen along its front edge when it is closed */
  .lid-edge {
    position: absolute;
    left: 0.4%;
    right: 0.4%;
    bottom: 100%;
    height: calc(var(--W) * 0.008);
    transform-origin: bottom center;
    transform: rotateX(90deg);
    border-radius: 999px;
    background: linear-gradient(180deg, #f6f7f9, #cdced3 60%, #b4b5ba);
  }

  /* Soft contact shadow on the desk */
  .floor {
    position: absolute;
    left: 4%;
    right: 4%;
    top: calc(var(--H) * -0.04);
    height: calc(var(--H) * 1.08);
    transform-origin: top center;
    transform: rotateX(90deg) translateZ(calc(var(--W) * -0.03));
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.28), rgb(0 0 0 / 0.1) 60%, transparent);
  }

  .lid-front,
  .lid-back {
    position: absolute;
    inset: 0;
    border-radius: calc(var(--W) * 0.03) calc(var(--W) * 0.03) calc(var(--W) * 0.008) calc(var(--W) * 0.008);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* The aluminium frame: a soft silver gradient with a bright inner rim, like the real lid's edge */
  .lid-front {
    background: linear-gradient(180deg, #eceef1 0, #d6d7dc 45%, #c4c5ca 100%);
    padding: calc(var(--W) * 0.007);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.8),
      inset 0 -1px 0 rgb(0 0 0 / 0.08),
      0 0 0 1px rgb(0 0 0 / 0.08);
  }

  .lid-back {
    transform: translateZ(calc(var(--W) * -0.008)) rotateY(180deg);
    /* Seen from above when closed, so every corner is softly rounded like the real lid */
    border-radius: calc(var(--W) * 0.03);
    display: grid;
    place-items: center;
    background:
      linear-gradient(112deg, transparent 32%, rgb(255 255 255 / 0.4) 46%, transparent 62%),
      radial-gradient(90% 70% at 50% 50%, rgb(255 255 255 / 0.35), transparent 75%),
      linear-gradient(0deg, #eceef1, #dcdde1 45%, #cfd0d5);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.07),
      inset 0 0 0 2px rgb(255 255 255 / 0.55);
  }

  .lid-glyph {
    color: #c3c4c9;
    width: calc(var(--W) * 0.075);
    /* Engraved: light lip below, soft shade above */
    filter: drop-shadow(0 1px 0 rgb(255 255 255 / 0.9)) drop-shadow(0 -1px 0 rgb(0 0 0 / 0.08));
  }

  .lid-glyph :global(svg) {
    width: 100%;
    height: auto;
  }

  .bezel {
    position: relative;
    height: 100%;
    /* Corner radii step down evenly (frame 3.0, bezel 2.3, screen 1.5 % of the width), so every corner is concentric */
    border-radius: calc(var(--W) * 0.023) calc(var(--W) * 0.023) calc(var(--W) * 0.006) calc(var(--W) * 0.006);
    background: #050505;
    padding: calc(var(--W) * 0.008) calc(var(--W) * 0.008) calc(var(--W) * 0.02);
  }

  /* The camera notch, cut into the top of the screen */
  .notch-cam {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: 4;
    width: 13cqw;
    height: 3.6cqh;
    translate: -50% 0;
    display: grid;
    place-items: center;
    border-radius: 0 0 1.2cqw 1.2cqw;
    background: #050505;
  }

  .notch-cam i {
    width: 0.7cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #2b3550, #0b0e16 70%);
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--W) * 0.015) calc(var(--W) * 0.015) calc(var(--W) * 0.004) calc(var(--W) * 0.004);
    container-type: size;
    background: #000;
  }

  .wall {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90% 75% at 50% 112%, rgb(255 194 71 / 0.75), rgb(255 140 30 / 0.2) 55%, transparent 80%),
      radial-gradient(60% 50% at 50% 30%, rgb(255 246 204 / 0.06), transparent),
      #140f08;
  }

  .menubar {
    position: absolute;
    inset: 0 0 auto;
    height: 4.2cqh;
    padding: 0 1.6cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.35cqw;
    color: rgb(255 255 255 / 0.85);
    background: rgb(0 0 0 / 0.35);
  }

  .mb-left,
  .mb-right {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
  }

  .mb-glyph {
    color: var(--accent);
    width: 1.9cqw;
  }

  .mb-glyph :global(svg) {
    width: 100%;
    height: auto;
  }

  .mb-dot {
    width: 0.7cqw;
    height: 0.7cqw;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0.8cqw var(--gold);
  }

  .open-sign {
    position: absolute;
    inset: 4.2cqh 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.6cqh;
    text-align: center;
  }

  .open-sign :global(.open-icon) {
    width: 13cqw;
    height: auto;
    filter: drop-shadow(0 1.5cqw 3cqw rgb(255 160 40 / 0.45));
  }

  .open-title {
    margin: 1cqh 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 5.6cqw;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #fff;
  }

  .open-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.9cqw;
    margin: 0;
    padding: 0.8cqw 1.6cqw;
    border-radius: 99px;
    font-size: 1.7cqw;
    font-weight: 600;
    color: var(--on-gold);
    background: var(--light);
  }

  .open-chip .eq {
    display: flex;
    height: 1.6cqw;
    gap: 0.25cqw;
  }

  .open-chip .eq i {
    width: 0.35cqw;
    height: 1.6cqw;
  }

  /* The shop shutter on the screen */
  .shutter {
    position: absolute;
    inset: 0;
  }

  .slats {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.35), transparent 8%, transparent 92%, rgb(0 0 0 / 0.35)),
      repeating-linear-gradient(
        180deg,
        #6b6b72 0,
        #8a8a92 1.2cqh,
        #5b5b62 3.2cqh,
        #3d3d43 3.6cqh,
        #6b6b72 4cqh
      );
  }

  .sign {
    position: absolute;
    left: 50%;
    top: 30%;
    translate: -50% 0;
    rotate: -3deg;
    padding: 1.4cqw 3cqw;
    border-radius: 1cqw;
    background: #f7efe1;
    color: #3b2a14;
    text-align: center;
    box-shadow: 0 1cqw 2cqw rgb(0 0 0 / 0.4);
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .sign span {
    font-size: 1.8cqw;
    font-weight: 500;
  }

  .sign strong {
    font-family: var(--font-display);
    font-size: 4.4cqw;
    letter-spacing: -0.03em;
    color: var(--rust);
  }

  .sign::before,
  .sign::after {
    content: '';
    position: absolute;
    top: -7cqh;
    width: 0.25cqw;
    height: 8cqh;
    background: #222;
  }

  .sign::before {
    left: 22%;
    rotate: 14deg;
  }

  .sign::after {
    right: 22%;
    rotate: -14deg;
  }

  .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3.4cqh;
    background: linear-gradient(180deg, #d0581c, var(--rust));
    box-shadow: 0 -0.3cqh 0 rgb(0 0 0 / 0.3);
  }

  .screen-off {
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
  }

  /* The desktop with the app on it, shown once the shutter is up */
  .desk-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: auto;
    transform-origin: 50% 100%;
  }

  /* The screen fades into the page at the bottom, like the lid continues below the fold */
  .pin::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 14svh;
    z-index: 4;
    background: linear-gradient(180deg, rgb(255 255 255 / 0), var(--bg) 85%);
    opacity: 0;
    pointer-events: none;
  }

  .pin.is-open::after {
    opacity: 1;
    transition: opacity 0.6s;
  }

  /* MARK: Hint */

  .hint {
    position: absolute;
    left: 50%;
    bottom: 22px;
    translate: -50% 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 13px;
    color: var(--text-3);
  }

  .hint :global(svg) {
    width: 18px;
    height: 18px;
    animation: nudge 1.6s ease-in-out infinite;
  }

  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 640px) {
    .live-cta {
      display: none;
    }

    .live-pill {
      padding-right: 14px;
    }

    .ctas .btn {
      flex: 1 1 160px;
    }
  }

  /* Small screens: the lid stands taller, so the app in it can be read */
  @media (max-width: 820px) {
    .pin {
      --W: min(94vw, 760px);
      --H: min(calc(var(--W) * 1.9), max(calc(100svh - 150px), 260px));
    }
  }

  /* Without motion, show the open lid right away, under the text */
  @media (prefers-reduced-motion: reduce) {
    .pin {
      height: auto;
      min-height: 0;
      padding-bottom: 24px;
    }

    .stage {
      position: relative;
      top: auto;
      width: 100%;
      height: calc(var(--H) + 24px);
      margin-top: 40px;
    }

    .rig {
      top: calc(var(--H) + 24px);
      transform: none;
    }

    .lid {
      transform: rotateX(3deg);
    }

    .floor {
      display: none;
    }

    .shutter,
    .screen-off,
    .hint,
    .pin::after {
      display: none;
    }

    .wall {
      display: none;
    }

    .desk-layer {
      opacity: 1;
      visibility: visible;
    }

    .glow {
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { play, subscribe, getState, enableSound } from '../scripts/audio';
  import { allSounds, shutterHit } from '../data/sounds';
  import { sparkle } from '../scripts/sparkle';

  gsap.registerPlugin(ScrollTrigger);

  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
  const pin = $<HTMLElement>('[data-pin]');
  const lid = $<HTMLElement>('[data-lid]');
  const stage = $<HTMLElement>('.stage');
  const shutter = $<HTMLElement>('[data-shutter]');
  const openSign = $<HTMLElement>('[data-open]');
  const deskLayer = $<HTMLElement>('[data-desk-layer]');
  const rig = $<HTMLElement>('[data-rig]');
  const nowTitle = $<HTMLElement>('[data-now-title]');
  const hear = $<HTMLButtonElement>('[data-hear]');
  const hearLabel = $<HTMLElement>('[data-hear-label]');

  // Live clock in the screen's menu bar.
  const clock = $<HTMLElement>('[data-clock]');
  const tick = () => (clock.textContent = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }));
  tick();
  setInterval(tick, 30_000);

  const titleOf = (id: string) => allSounds.find((s) => s.id === id)?.title ?? '';

  subscribe(({ openSound, soundOn }) => {
    nowTitle.textContent = titleOf(openSound);
    hear.classList.toggle('is-on', soundOn);
  });

  hear.addEventListener('click', () => {
    enableSound();
    play(getState().openSound);
    hearLabel.textContent = 'Play again';
  });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion) {
    (window as unknown as { __deskLive?: boolean }).__deskLive = true;
    window.dispatchEvent(new Event('lidshutter:desk-live'));
  }

  if (!reduceMotion) {
    // The shutter rolls up in time with the chosen open sound: it finishes
    // exactly on that sound's hit (the ka-chunk, final ding, splash...).
    let roll: gsap.core.Timeline | null = null;
    let pending: gsap.core.Tween | null = null;

    function buildRoll(hit: number) {
      return gsap
        .timeline({ paused: true })
        .set(openSign, { scale: 0.92, opacity: 0 })
        .fromTo(shutter, { yPercent: 0 }, { yPercent: -101, duration: hit, ease: 'power1.in' })
        .to(openSign, { scale: 1, opacity: 1, duration: 0.6, ease: 'back.out(2.2)' }, hit)
        .call(() => {
          const icon = openSign.querySelector('img');
          if (icon) sparkle(icon, '#ffc247', 1.4);
        }, [], hit + 0.05)
        // "Your shop is open", then the Mac's desktop with the app on it
        .to(openSign, { opacity: 0, scale: 1.04, duration: 0.35, ease: 'power1.in' }, hit + 1.1)
        .fromTo(deskLayer, { autoAlpha: 0, scale: 0.97 }, { autoAlpha: 1, scale: 1, duration: 0.7, ease: 'power2.out' }, hit + 1.05)
        .call(deskIsLive, [], hit + 1.5);
    }

    const deskIsLive = () => {
      (window as unknown as { __deskLive?: boolean }).__deskLive = true;
      window.dispatchEvent(new Event('lidshutter:desk-live'));
    };

    let isOpen = false;

    const openShop = () => {
      if (isOpen) return;
      isOpen = true;
      const { openSound, playOnOpen, enabled } = getState();
      const delay = playOnOpen && enabled ? play(openSound, { userInitiated: false }) : 0;
      roll?.kill();
      pending?.kill();
      roll = buildRoll(shutterHit[openSound] ?? 0.9);
      // Wait for the sound to actually reach the speakers, then roll in lockstep.
      pending = gsap.delayedCall(delay, () => roll?.play(0));
    };

    const closeShop = () => {
      if (!isOpen) return;
      isOpen = false;
      pending?.kill();
      roll?.timeScale(3).reverse();
    };

    let closedSoundArmed = false;

    const sync = (p: number, direction = 0) => {
      if (p > 0.5) openShop();
      if (p < 0.38) closeShop();
      // Play the close sound when scrolling back and the lid is nearly shut.
      if (p > 0.25) closedSoundArmed = true;
      if (closedSoundArmed && p < 0.08 && direction < 0) {
        closedSoundArmed = false;
        const { closeSound, playOnClose, enabled } = getState();
        if (playOnClose && enabled) play(closeSound, { userInitiated: false });
      }
    };

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: pin,
        start: 'top top',
        end: '+=130%',
        pin: true,
        scrub: 0.3,
        onUpdate: (self) => sync(self.progress, self.direction),
        // Covers a page that loads already scrolled down (refresh, back button).
        onRefresh: (self) => sync(self.progress),
      },
    });

    // The lid ends up standing in front of you, its hinge just below the fold.
    const hingeY = () => window.innerHeight + rig.offsetWidth * 0.03 - stage.offsetTop;

    // autoAlpha also hides them from clicks once they've faded, so the app in the lid can be used
    tl.to('[data-hint]', { autoAlpha: 0, duration: 0.08 }, 0)
      .to('[data-faces="hero"]', { autoAlpha: 0, y: -80, scale: 1.06, duration: 0.42 }, 0.02)
      .to('[data-copy]', { autoAlpha: 0, y: -60, scale: 0.96, duration: 0.42 }, 0.04)
      .to(lid, { rotateX: 4, duration: 0.6, ease: 'power1.inOut' }, 0)
      .to('.lid-edge', { autoAlpha: 0, duration: 0.15 }, 0)
      .to(rig, { rotateX: 0, duration: 0.6 }, 0)
      .to(stage, { y: hingeY, duration: 0.6, ease: 'power1.inOut' }, 0)
      .to('[data-screen-off]', { opacity: 0, duration: 0.25 }, 0.12)
      .to('[data-glow]', { opacity: 1, duration: 0.55 }, 0.05)
      .to({}, { duration: 0.4 });

    // "Explore sounds" and the other links to the app: open the lid, then pick the pane.
    document.querySelectorAll<HTMLElement>('[data-app-pane]').forEach((link) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const st = tl.scrollTrigger!;
        window.scrollTo({ top: st.start + (st.end - st.start) * 0.9, behavior: 'smooth' });
      }),
    );

    // The bottom fade only once the lid is up.
    ScrollTrigger.create({
      trigger: pin,
      start: 'top top',
      end: '+=130%',
      onUpdate: (self) => pin.classList.toggle('is-open', self.progress > 0.5),
    });
  }
</script>
