---
import type { SoundId, Tint } from '../data/sounds';

interface Props {
  sound: SoundId | '@open' | '@close';
  tint: Tint;
  label: string;
  size?: number;
  class?: string;
}

const { sound, tint, label, size = 32, class: className } = Astro.props;
---

<button
  type="button"
  class:list={['play', className]}
  data-play={sound}
  data-tint={tint}
  style={`--size:${size}px`}
  aria-label={`Play ${label}`}
  data-label={label}
>
  <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.87l12.5-7.5a1 1 0 0 0 0-1.74L8.5 3.63A1 1 0 0 0 7 4.5Z" /></svg>
  <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
</button>
