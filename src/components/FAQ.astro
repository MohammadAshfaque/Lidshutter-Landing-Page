---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { faqs } from '../data/faq';
---

<section class="section" id="faq">
  <div class="container wide">
    <div class="layout">
      <div class="list" role="list">
        {
          faqs.map((f, i) => (
            <details class="item reveal" style={`--delay:${i * 0.04}s`} name="faq" role="listitem">
              <summary>
                <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="q">{f.q}</span>
                <span class="chev" aria-hidden="true">
                  <Icon name="ChevronDown" />
                </span>
              </summary>
              <div class="a">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>

      <aside class="head reveal">
        <p class="eyebrow"><Icon name="MousePointerClick" /> Questions</p>
        <h2 class="h2">Good to know.</h2>
        <p class="lead">Licenses, offline use, your Macs and your privacy, answered in a few lines.</p>
        <a class="ask" href={`mailto:${site.supportEmail}`}>
          <span>Still curious?</span>
          <strong>Email {site.supportEmail}</strong>
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  .wide {
    max-width: calc(1120px + var(--gutter) * 2);
  }

  /* Answers on the left, the heading on the right */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }

  .head {
    order: 2;
    position: sticky;
    top: 110px;
    display: grid;
    justify-items: start;
    gap: 14px;
  }

  .head .h2 {
    margin: 0;
  }

  .head .lead {
    margin: 0;
    max-width: 340px;
    color: var(--text-2);
  }

  .ask {
    margin-top: 10px;
    display: grid;
    gap: 2px;
    padding: 16px 20px;
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: 0 0 0 1px var(--stroke) inset;
    color: var(--text-2);
    font-size: 14px;
    transition: background-color 0.2s, transform 0.35s var(--spring);
  }

  .ask strong {
    color: var(--accent);
    font-weight: 600;
    font-size: 15px;
  }

  .ask:hover {
    background: var(--card-hover);
    transform: translateY(-2px);
  }

  .list {
    order: 1;
    border-top: 1px solid var(--stroke);
  }

  .item {
    border-bottom: 1px solid var(--stroke);
  }

  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 30px;
    align-items: center;
    gap: 10px;
    padding: 22px 4px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
    cursor: pointer;
    transition: color 0.2s;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover .q {
    color: var(--accent);
  }

  .num {
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--text-3);
  }

  .chev {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--fill);
    transition: transform 0.4s var(--spring), background-color 0.2s, color 0.2s;
  }

  .chev :global(svg) {
    width: 16px;
    height: 16px;
  }

  .item[open] .chev {
    transform: rotate(180deg);
    background: rgb(255 194 71 / 0.2);
    color: var(--accent);
  }

  .item[open] .q {
    color: var(--text);
  }

  .a {
    padding: 0 40px 24px 44px;
  }

  .a p {
    margin: 0;
    max-width: 600px;
    color: var(--text-2);
  }

  .item[open] .a {
    animation: slide 0.35s var(--ease-out);
  }

  @keyframes slide {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    /* Heading first when stacked */
    .head {
      order: 0;
      position: static;
    }

    .list {
      order: 1;
    }

    .a {
      padding: 0 8px 22px 44px;
    }
  }
</style>
