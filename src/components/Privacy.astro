---
import Icon from './Icon.astro';

const points = [
  { icon: 'WifiOff', title: 'Works offline', body: 'Internet only to activate and to look for updates. Otherwise it works offline.' },
  { icon: 'EyeOff', title: 'Zero data collected', body: 'The app has no account, no analytics, no tracking.' },
  { icon: 'Code', title: 'Sounds made in code', body: 'Generated on your Mac in milliseconds. No audio files.' },
];
---

<section class="section privacy-section" id="privacy">
  <div class="container">
    <div class="panel reveal">
      <div class="inner">
        <figure class="wave-fig">
          <canvas class="wave" data-privacy-wave aria-hidden="true"></canvas>
          <figcaption>The Rolling Shutter sound, drawn live from the same code the app uses.</figcaption>
        </figure>
        <p class="eyebrow"><Icon name="ShieldCheck" /> Private by design</p>
        <h2 class="h2">
          Works offline. No account.<br />No tracking. <span class="lit">Not even audio files.</span>
        </h2>
        <p class="lead">
          Every sound you hear is generated by code, right on your Mac, the moment it plays. Your stats stay on your Mac
          too.
        </p>
        <ul class="points">
          {
            points.map((p) => (
              <li>
                <span class="badge" style="--size:36px">
                  <Icon name={p.icon} />
                </span>
                <div>
                  <strong>{p.title}</strong>
                  <span>{p.body}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <!-- Notarized by Apple -->
        <div class="notary" data-notary>
          <span class="seal" aria-hidden="true">
            <svg viewBox="0 0 64 64">
              <path
                class="seal-shape"
                d="M32 3 l6.2 5.2 8-1.4 3.2 7.5 7.5 3.2 -1.4 8 5.2 6.2 -5.2 6.2 1.4 8 -7.5 3.2 -3.2 7.5 -8 -1.4 L32 61 l-6.2 -5.2 -8 1.4 -3.2 -7.5 -7.5 -3.2 1.4 -8 L3.3 32 l5.2 -6.2 -1.4 -8 7.5 -3.2 3.2 -7.5 8 1.4 Z"
              />
              <path class="seal-check" d="M21 33 l7.5 7.5 L44 25" />
            </svg>
          </span>
          <div class="notary-text">
            <strong>Notarized by Apple</strong>
            <span>Checked by Apple for malicious software, so it opens on your Mac without any warnings.</span>
          </div>
          <span class="verified" aria-hidden="true">Verified</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* No heading above the panel, so it sits closer to the section before it */
  .section.privacy-section {
    padding-top: clamp(24px, 3.5vw, 48px);
  }

  .panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    padding: clamp(36px, 5vw, 64px) clamp(20px, 6vw, 72px) clamp(44px, 6vw, 80px);
    text-align: center;
    background:
      radial-gradient(80% 60% at 50% 100%, rgb(255 194 71 / 0.1), transparent 70%),
      var(--bg-deep);
    box-shadow: 0 0 0 1px var(--stroke) inset;
  }

  .wave-fig {
    margin: 0 auto 36px;
    max-width: 760px;
  }

  .wave {
    width: 100%;
    height: 88px;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  figcaption {
    margin-top: 12px;
    font-size: 13px;
    color: var(--text-3);
  }

  .inner {
    position: relative;
  }

  .points {
    list-style: none;
    margin: 48px auto 0;
    padding: 0;
    max-width: 860px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    text-align: left;
  }

  .points li {
    display: flex;
    gap: 12px;
    padding: 18px;
    border-radius: var(--r-card);
    background: #fff;
    box-shadow: 0 0 0 1px var(--stroke) inset;
  }

  .points div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-2);
  }

  .points strong {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .notary {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 860px;
    margin: 16px auto 0;
    padding: 18px 20px;
    overflow: hidden;
    text-align: left;
    border-radius: var(--r-card);
    background: linear-gradient(135deg, rgb(97 217 153 / 0.1), rgb(97 217 153 / 0.03));
    box-shadow: 0 0 0 1px rgb(97 217 153 / 0.22) inset;
    transition: box-shadow 0.3s, transform 0.4s var(--spring);
  }

  /* A light sheen that sweeps across on hover */
  .notary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.7) 50%, transparent 65%);
    transform: translateX(-120%);
    pointer-events: none;
  }

  .notary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 0 1px rgb(97 217 153 / 0.4) inset, 0 16px 40px -16px rgb(97 217 153 / 0.4);
  }

  .notary:hover::after {
    transform: translateX(120%);
    transition: transform 0.9s var(--ease-out);
  }

  .seal {
    width: 52px;
    height: 52px;
    flex: none;
    transition: transform 0.6s var(--spring);
  }

  .notary:hover .seal {
    transform: rotate(18deg) scale(1.06);
  }

  .seal svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .seal-shape {
    fill: var(--mint);
    filter: drop-shadow(0 4px 12px rgb(97 217 153 / 0.45));
  }

  .seal-check {
    fill: none;
    stroke: #06281a;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
  }

  .notary.stamped .seal {
    animation: stamp 0.55s var(--spring) both;
  }

  .notary.stamped .seal-check {
    transition: stroke-dashoffset 0.5s var(--ease-out) 0.35s;
    stroke-dashoffset: 0;
  }

  @keyframes stamp {
    0% {
      transform: scale(1.8) rotate(-30deg);
      opacity: 0;
    }
    60% {
      transform: scale(0.92) rotate(4deg);
      opacity: 1;
    }
  }

  .notary-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-2);
  }

  .notary-text strong {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
  }

  .verified {
    flex: none;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: #06281a;
    background: var(--mint);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.3s 0.8s, transform 0.5s var(--spring) 0.8s;
  }

  .notary.stamped .verified {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .seal-check {
      stroke-dashoffset: 0;
    }

    .verified {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .verified {
      display: none;
    }

    .points {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { samplesFor } from '../scripts/audio';

  // The notarization seal stamps in and its checkmark draws once it scrolls into view.
  const notary = document.querySelector<HTMLElement>('[data-notary]')!;
  new IntersectionObserver(
    ([e], io) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      notary.classList.add('stamped');
    },
    { threshold: 0.6 },
  ).observe(notary);

  // Draw the real Rolling Shutter waveform, generated by the same code the app uses.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-privacy-wave]')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let peaks: number[] = [];
  let shown = 0;

  function computePeaks(bars: number) {
    const samples = samplesFor('rollingShutter');
    const size = Math.floor(samples.length / bars);
    return Array.from({ length: bars }, (_, i) => {
      let peak = 0;
      for (let j = i * size; j < (i + 1) * size; j++) peak = Math.max(peak, Math.abs(samples[j]));
      return peak;
    });
  }

  function draw() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const { width, height } = canvas.getBoundingClientRect();
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const gap = 3;
    const barW = 3;
    const count = peaks.length;
    const total = count * (barW + gap);
    const x0 = (width - total) / 2;
    const gradient = ctx.createLinearGradient(0, 0, 0, height);
    gradient.addColorStop(0, '#f7b23a');
    gradient.addColorStop(1, '#d4690f');
    ctx.fillStyle = gradient;
    for (let i = 0; i < count; i++) {
      // The full shape is always there; the "playhead" brightens it from left to right.
      const reveal = Math.max(0, Math.min(1, shown * count - i));
      const h = Math.max(2, peaks[i] * height * 0.9);
      ctx.globalAlpha = 0.22 + 0.78 * reveal;
      ctx.beginPath();
      ctx.roundRect(x0 + i * (barW + gap), (height - h) / 2, barW, h, 2);
      ctx.fill();
    }
  }

  function setup() {
    const width = canvas.getBoundingClientRect().width;
    peaks = computePeaks(Math.max(40, Math.floor(width / 6)));
    draw();
  }

  // Drawn right away, so the panel never opens on an empty strip.
  setup();

  const io = new IntersectionObserver(([e]) => {
    if (!e.isIntersecting) return;
    io.disconnect();
    if (reduceMotion) {
      shown = 1;
      draw();
      return;
    }
    const start = performance.now();
    const step = (now: number) => {
      shown = Math.min((now - start) / 1600, 1);
      draw();
      if (shown < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  });
  io.observe(canvas);
  window.addEventListener('resize', () => peaks.length && setup());
</script>
