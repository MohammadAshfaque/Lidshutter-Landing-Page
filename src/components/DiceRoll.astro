      radial-gradient(ellipse 10cqw 6cqw at 10cqw 0, transparent 98%, color-mix(in srgb, var(--tint) 85%, #0b3b2c) 100%) 0 0 / 20cqw 100% repeat-x;
  }

  .dice-stage .sc-spray {
    width: 1.8cqw;
