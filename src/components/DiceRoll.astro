  }

  /* Weather */
  .dice-stage .sc-cloud {
    left: 50%;
    top: 10%;
    width: 46cqw;
    height: 14cqw;
    translate: -50% 0;
    border-radius: 8cqw;
    background: #4a4a55;
    box-shadow: -10cqw -3cqw 0 -2cqw #4a4a55, 8cqw -5cqw 0 -1cqw #55555f;
    z-index: 3;
  }

  .dice-stage .sc-rain {
    top: 22%;
    width: 0.5cqw;
    height: 3.6cqw;
    border-radius: 1cqw;
    background: color-mix(in srgb, var(--tint) 70%, #fff);
  }

  .dice-stage .sc-bolt {
    left: 52%;
    top: 22%;
    width: 12cqw;
    height: 30cqw;
    translate: -50% 0;
    transform-origin: 50% 0;
    background: #ffe26b;
    clip-path: polygon(40% 0, 75% 0, 55% 40%, 85% 40%, 30% 100%, 45% 55%, 15% 55%);
    filter: drop-shadow(0 0 2cqw #ffe26b);
    opacity: 0;
    z-index: 2;
  }

  .dice-stage .sc-flash {
    inset: 0;
    background: #fff;
    opacity: 0;
  }

  .dice-stage .sc-wire {
    left: 10%;
    right: 10%;
    top: calc(46% + 9cqw);
    height: 0.4cqw;
    background: #555;
  }

  .dice-stage .sc-bird {
    width: 11cqw;
    height: 9cqw;
    translate: -50% 0;
    border-radius: 55% 55% 45% 45%;
    background: radial-gradient(circle at 40% 30%, color-mix(in srgb, var(--tint) 40%, #fff), var(--tint) 70%);
  }

  .dice-stage .sc-bird-eye {
    position: absolute;
    right: 24%;
    top: 30%;
    width: 1.4cqw;
    height: 1.4cqw;
    border-radius: 50%;
    background: #111;
  }

  .dice-stage .sc-bird-beak {
    position: absolute;
    right: -1.6cqw;
    top: 40%;
    width: 2.4cqw;
    height: 1.6cqw;
    background: #ff9a3d;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .dice-stage .sc-chirp {
    width: 4cqw;
    height: 4cqw;
    translate: -50% -50%;
    border-radius: 50%;
    border: 0.5cqw solid var(--tint);
    border-left-color: transparent;
    border-bottom-color: transparent;
    rotate: 45deg;
  }

  .dice-stage .sc-sun {
    left: 50%;
    top: 20%;
    width: 22cqw;
    height: 22cqw;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle, #fff6cc, #ffc247 60%, transparent 72%);
  }

  .dice-stage .sc-pine {
    bottom: 0;
    width: 16cqw;
    height: 30cqw;
    background: color-mix(in srgb, var(--tint) 70%, #04342c);
    clip-path: polygon(50% 0, 80% 35%, 66% 35%, 92% 70%, 72% 70%, 100% 100%, 0 100%, 28% 70%, 8% 70%, 34% 35%, 20% 35%);
  }

  /* Vehicles */
  .dice-stage .sc-road {
    left: 0;
    right: 0;
    top: 72%;
    height: 0.6cqw;
    background: repeating-linear-gradient(90deg, #444 0 6cqw, transparent 6cqw 10cqw);
  }

  .dice-stage .sc-car {
    left: 22%;
    top: calc(72% - 12cqw);
    width: 34cqw;
    height: 10cqw;
    border-radius: 4cqw 6cqw 2cqw 2cqw;
    background: linear-gradient(180deg, color-mix(in srgb, var(--tint) 70%, #fff), var(--tint));
    z-index: 2;
  }

  .dice-stage .sc-cabin {
    position: absolute;
    left: 26%;
    top: -4.6cqw;
    width: 44%;
    height: 5cqw;
    border-radius: 3cqw 4cqw 0 0;
    background: linear-gradient(180deg, #cfe8ff, #7aa0c0);
  }

  .dice-stage .sc-wheel {
    position: absolute;
    bottom: -3cqw;
    width: 7cqw;
    height: 7cqw;
    border-radius: 50%;
    background: radial-gradient(circle, #ddd 0 22%, #222 24% 100%);
    border: 0.6cqw dashed #555;
  }

  .dice-stage .sc-wheel.is-back {
    left: 12%;
  }

  .dice-stage .sc-wheel.is-front {
    right: 12%;
  }

  .dice-stage .sc-speed {
    left: 4%;
    width: 18cqw;
    height: 0.6cqw;
    transform-origin: 100% 50%;
    border-radius: 1cqw;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.6));
  }

  .dice-stage .sc-beep {
    right: 8%;
    padding: 1cqw 2.4cqw;
    border-radius: 2cqw;
    font-size: 3.6cqw;
    font-weight: 800;
    color: #2b1d00;
    background: #fff;
  }

  .dice-stage .sc-jet {
    left: 50%;
    top: 46%;
    width: 18cqw;
    height: 8cqw;
    translate: -50% -50%;
    rotate: -14deg;
    z-index: 2;
  }

  .dice-stage .sc-jet-body {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #f5f5f7, #b9b9c2);
    clip-path: polygon(0 50%, 30% 38%, 45% 0, 55% 0, 58% 38%, 100% 46%, 100% 54%, 58% 62%, 55% 100%, 45% 100%, 30% 62%);
  }

  .dice-stage .sc-jet-tail {
    position: absolute;
    right: 92%;
    top: 50%;
    width: 50cqw;
    height: 1.2cqw;
    translate: 0 -50%;
    transform-origin: 100% 50%;
    border-radius: 1cqw;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--tint) 70%, #fff));
  }

  /* Zips */
  .dice-stage .sc-zip {
    left: 12%;
    right: 12%;
    top: 50%;
    height: 8cqw;
    translate: 0 -50%;
    background: repeating-linear-gradient(90deg, #c9c9d0 0 1.2cqw, transparent 1.2cqw 2.4cqw) 0 0 / 100% 40% no-repeat,
      repeating-linear-gradient(90deg, transparent 0 1.2cqw, #c9c9d0 1.2cqw 2.4cqw) 0 100% / 100% 40% no-repeat;
  }

  .dice-stage .sc-zip-gap {
    position: absolute;
    inset: 30% 0;
    border-radius: 2cqw;
    background: linear-gradient(90deg, var(--tint), color-mix(in srgb, var(--tint) 50%, #fff));
    box-shadow: 0 0 4cqw var(--tint);
  }

  .dice-stage .sc-zip-slider {
    position: absolute;
    top: 50%;
    width: 6cqw;
    height: 10cqw;
    translate: -50% -50%;
    border-radius: 1.4cqw;
    background: linear-gradient(180deg, #f5f5f7, #9a9aa3);
    box-shadow: 0 1cqw 2cqw rgb(0 0 0 / 0.4);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { play, onPlay, samplesFor } from '../scripts/audio';
  import { scenes } from '../scripts/scenes';
  import { openGroups, closeGroup, type SoundId } from '../data/sounds';
  import { sparkle, tintColor } from '../scripts/sparkle';

  const groups = [...openGroups, closeGroup];
  const info = new Map(
    groups.flatMap((g) => g.sounds.map((s) => [s.id, { ...s, tint: g.tint, group: g.id === 'close' ? 'Lid closes' : g.title }] as const)),
  );
  const ids = [...info.keys()];

  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
  const diceButton = $<HTMLButtonElement>('[data-big-dice]');
  const cube = $<HTMLElement>('[data-dice-cube]');
  const hop = $<HTMLElement>('[data-dice-hop]');
  const shadow = $<HTMLElement>('[data-dice-shadow]');
  const card = $<HTMLElement>('[data-stage-card]');
  const scene = $<HTMLElement>('[data-scene]');
  const idle = $<HTMLElement>('[data-idle]');
  const chip = $<HTMLElement>('[data-chip]');
  const replay = $<HTMLButtonElement>('[data-replay]');
  const title = $<HTMLElement>('[data-stage-title]');
  const sub = $<HTMLElement>('[data-stage-sub]');
  const badge = $<HTMLElement>('.stage-badge');
  const wave = $<HTMLCanvasElement>('[data-wave]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // MARK: Collection ("Found 5 of 22")

  const FOUND_KEY = 'lidshutter.found';
  let found = new Set<string>();
  try {
    found = new Set(JSON.parse(localStorage.getItem(FOUND_KEY) ?? '[]'));
  } catch {
    /* storage unavailable */
  }

  function renderFound(justFound?: string) {
    document.querySelectorAll<HTMLElement>('[data-dot]').forEach((d) => {
      d.classList.toggle('on', found.has(d.dataset.dot!));
      if (d.dataset.dot === justFound) {
        d.classList.add('just');
        setTimeout(() => d.classList.remove('just'), 400);
      }
    });
    const text = $<HTMLElement>('[data-found-text]');
    text.innerHTML =
      found.size === ids.length
        ? `You heard all <b>${ids.length}</b>! Roll again for a new round`
        : `Found <b data-found>${found.size}</b> of ${ids.length} sounds`;
  }

  function saveFound() {
    try {
      localStorage.setItem(FOUND_KEY, JSON.stringify([...found]));
    } catch {
      /* storage unavailable */
    }
  }

  /** All 22 heard: clear the dots one by one and start a fresh round. */
  function newRound() {
    found.clear();
    saveFound();
    const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
    if (reduceMotion) {
      renderFound();
      return;
    }
    dots.forEach((d, i) => setTimeout(() => d.classList.remove('on'), i * 25));
    setTimeout(renderFound, dots.length * 25);
  }
  renderFound();

  /**
   * Every sound plays exactly once per round, in a random order. After all of them,
   * a new round starts, and its first sound is never the one that just played.
   */
  function nextSound(): SoundId {
    if (found.size >= ids.length) newRound();
    const pool = ids.filter((id) => !found.has(id) && id !== current);
    return pool[Math.floor(Math.random() * pool.length)] as SoundId;
  }

  // MARK: Dice

  // Rotation that brings each face to the front.
  const faceRotation: Record<number, [number, number]> = { 1: [0, 0], 6: [0, 180], 3: [0, -90], 4: [0, 90], 2: [-90, 0], 5: [90, 0] };
  let rx = 0;
  let ry = 0;
  let rolling = false;
  let current: SoundId | null = null;

  function roll(): Promise<void> {
    const face = 1 + Math.floor(Math.random() * 6);
    const [fx, fy] = faceRotation[face];
    // Always spin forward by two to three full turns, ending on the chosen face.
    rx = Math.ceil(rx / 360) * 360 + 720 + fx;
    ry = Math.ceil(ry / 360) * 360 + 360 * (1 + Math.round(Math.random())) + fy;
    if (reduceMotion) {
      gsap.set(cube, { rotationX: rx, rotationY: ry });
      return Promise.resolve();
    }
    return new Promise((resolve) => {
      gsap
        .timeline({ onComplete: resolve })
        .to(cube, { rotationX: rx, rotationY: ry, duration: 0.95, ease: 'power3.out' }, 0)
        .to(hop, { y: -110, duration: 0.32, ease: 'power2.out' }, 0)
        .to(hop, { y: 0, duration: 0.5, ease: 'bounce.out' }, 0.32)
        .to(shadow, { scale: 0.5, opacity: 0.4, duration: 0.32, ease: 'power2.out' }, 0)
        .to(shadow, { scale: 1, opacity: 1, duration: 0.5, ease: 'bounce.out' }, 0.32)
        // A little squash as it lands.
        .to(hop, { scaleY: 0.9, scaleX: 1.06, duration: 0.07, yoyo: true, repeat: 1, ease: 'power1.out' }, 0.5);
    });
  }

  // MARK: Stage

  let sceneTl: gsap.core.Timeline | null = null;
  let waveTween: gsap.core.Tween | null = null;
  let peaks: number[] = [];

  function drawWave(progress: number, tint: string) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const { width, height } = wave.getBoundingClientRect();
    if (!width) return;
    if (wave.width !== Math.round(width * dpr)) {
      wave.width = Math.round(width * dpr);
      wave.height = Math.round(height * dpr);
    }
    const ctx = wave.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, width, height);
    const step = width / peaks.length;
    peaks.forEach((p, i) => {
      const h = Math.max(2, p * height * 0.92);
      ctx.fillStyle = i / peaks.length <= progress ? tint : 'rgba(255,255,255,0.16)';
      ctx.beginPath();
      ctx.roundRect(i * step, (height - h) / 2, Math.max(1.5, step - 1.5), h, 1.5);
      ctx.fill();
    });
  }

  function computePeaks(samples: Float32Array) {
    const bars = Math.max(30, Math.floor(wave.getBoundingClientRect().width / 4));
    const size = Math.floor(samples.length / bars);
    peaks = Array.from({ length: bars }, (_, i) => {
      let peak = 0;
      for (let j = i * size; j < (i + 1) * size; j++) peak = Math.max(peak, Math.abs(samples[j]));
      return peak;
    });
  }

  /** The sound's icon flies out of the dice and into the stage. */
  function flyOut(id: SoundId, tint: string) {
    if (reduceMotion) return;
    const from = hop.getBoundingClientRect();
    const to = scene.getBoundingClientRect();
    const source = badge.querySelector<HTMLElement>(`[data-stage-icon="${id}"] svg`);
    const flyer = document.createElement('div');
    flyer.className = 'badge';
    flyer.innerHTML = source?.outerHTML ?? '';
    Object.assign(flyer.style, {
      position: 'fixed',
      left: `${from.left + from.width / 2 - 28}px`,
      top: `${from.top + from.height / 2 - 28}px`,
      zIndex: '40',
      pointerEvents: 'none',
      ['--size' as string]: '56px',
      ['--tint' as string]: tint,
      background: tint,
      color: '#1a1100',
      boxShadow: `0 10px 40px -6px ${tint}`,
    });
    document.body.appendChild(flyer);
    const dx = to.left + to.width / 2 - (from.left + from.width / 2);
    const dy = to.top + to.height / 2 - (from.top + from.height / 2);
    gsap
      .timeline({ onComplete: () => flyer.remove() })
      .fromTo(flyer, { scale: 0.3, rotate: -30 }, { scale: 1.15, rotate: 0, duration: 0.18, ease: 'back.out(3)' })
      .to(flyer, { keyframes: { x: [0, dx * 0.5, dx], y: [0, dy - 90, dy], ease: 'none' }, duration: 0.42, ease: 'power2.inOut' }, 0.05)
      .to(flyer, { scale: 1.8, opacity: 0, duration: 0.2, ease: 'power2.out' }, 0.45);
  }

  function show(id: SoundId, { fly = true } = {}) {
    const s = info.get(id)!;
    current = id;
    card.dataset.tint = s.tint;
    const tint = tintColor(card);

    // Header and caption.
    chip.textContent = s.group;
    title.textContent = s.title;
    sub.textContent = s.subtitle;
    replay.hidden = false;
    idle.classList.add('is-hidden');
    badge.querySelectorAll<HTMLElement>('[data-stage-icon]').forEach((i) => i.classList.toggle('show', i.dataset.stageIcon === id));
    badge.classList.remove('pop');
    void badge.offsetWidth;
    badge.classList.add('pop');

    // Sound first, so everything can be timed to when it's actually heard.
    const delay = play(id);
    if (fly) flyOut(id, tint);

    sceneTl?.kill();
    waveTween?.kill();
    gsap.set(scene, { clearProps: 'transform' });
    scene.replaceChildren();
    sceneTl = scenes[id](scene);

    const samples = samplesFor(id);
    const duration = samples.length / 44_100;
    computePeaks(samples);
    const progress = { p: 0 };
    drawWave(0, tint);

    if (reduceMotion) {
      sceneTl.progress(1);
      drawWave(1, tint);
      return;
    }
    gsap.delayedCall(delay, () => sceneTl?.play(0));
    waveTween = gsap.to(progress, {
      p: 1,
      duration,
      delay,
      ease: 'none',
      onUpdate: () => drawWave(progress.p, tint),
    });
  }

  async function rollAndShow() {
    if (rolling) return;
    rolling = true;
    diceButton.classList.add('is-rolling', 'is-used');
    $('[data-dice-cta]').style.opacity = '0';
    const id = nextSound();
    await roll();
    diceButton.classList.remove('is-rolling');
    sparkle(hop, '#ffc247', 1);
    found.add(id);
    saveFound();
    renderFound(id);
    if (found.size === ids.length) sparkle($('[data-found-text]'), '#61d999', 1.2);
    show(id);
    rolling = false;
  }

  diceButton.addEventListener('click', rollAndShow);
  replay.addEventListener('click', () => current && show(current, { fly: false }));

  // Until the first roll, give the dice a little nudge now and then.
  const nudge = setInterval(() => {
    if (diceButton.classList.contains('is-used')) return clearInterval(nudge);
    diceButton.classList.remove('nudge');
    void diceButton.offsetWidth;
    diceButton.classList.add('nudge');
  }, 3500);

  // If another part of the page plays a sound, stop this stage's show.
  onPlay((id) => {
    if (id !== current) {
      sceneTl?.pause();
      waveTween?.kill();
    }
  });
</script>
