---
import Icon from './Icon.astro';
import Glyph from './Glyph.astro';
import { openGroups, closeGroup, totalSoundCount } from '../data/sounds';

const groups = [...openGroups, closeGroup];
const sounds = groups.flatMap((g) => g.sounds.map((s) => ({ ...s, tint: g.tint, group: g.title })));

// Pip positions on a 3×3 grid for each face.
const pips: Record<number, number[]> = {
  1: [4],
  2: [0, 8],
  3: [0, 4, 8],
  4: [0, 2, 6, 8],
  5: [0, 2, 4, 6, 8],
  6: [0, 2, 3, 5, 6, 8],
};
const faces = ['front', 'back', 'right', 'left', 'top', 'bottom'];
const faceNumber: Record<string, number> = { front: 1, back: 6, right: 3, left: 4, top: 2, bottom: 5 };
---

<section class="section roll-section" id="roll">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow"><Icon name="Dices" /> Feel the sounds</p>
      <h2 class="h2">{totalSoundCount} sounds live in this dice.</h2>
      <p class="lead">Give it a roll. Whatever comes out plays, with its own little show.</p>
    </div>

    <div class="roll-grid">
      <div class="dice-side reveal">
        <button type="button" class="big-dice" data-big-dice aria-label="Roll the dice for a random sound">
          <span class="dice-hop" data-dice-hop>
            <span class="dice-tilt">
              <span class="dice" data-dice-cube>
                {faces.map((f) => <span class={`core core-${f}`} />)}
                {
                  faces.map((f) => (
                    <span class={`face face-${f}`}>
                      {Array.from({ length: 9 }, (_, i) => (
                        <i class:list={[{ on: pips[faceNumber[f]].includes(i) }]} />
                      ))}
                    </span>
                  ))
                }
              </span>
            </span>
          </span>
          <span class="dice-shadow" data-dice-shadow></span>
        </button>
        <p class="dice-cta" data-dice-cta>Tap the dice to roll</p>

        <div class="found" aria-live="polite">
          <div class="found-dots" aria-hidden="true">
            {sounds.map((s) => <i data-dot={s.id} data-tint={s.tint} title={s.title} />)}
          </div>
          <span class="found-text" data-found-text>Found <b data-found>0</b> of {totalSoundCount} sounds</span>
        </div>
      </div>

      <div class="stage-card reveal" style="--delay:.1s" data-stage-card data-tint="gold" data-dark>
        <div class="stage-top">
          <span class="chip" data-chip>Ready when you are</span>
          <button type="button" class="replay" data-replay hidden aria-label="Play this sound again">
            <Icon name="RotateCcw" /> Replay
          </button>
        </div>

        <div class="stage-area">
          <div class="scene dice-stage" data-scene></div>
          <div class="idle" data-idle>
            <span class="idle-arrow"><Icon name="ArrowLeft" /></span>
            <p>Roll the dice and a sound pops out here.</p>
          </div>
        </div>

        <div class="stage-bottom">
          <span class="badge stage-badge" style="--size:44px">
            {
              sounds.map((s) => (
                <span class="s-icon" data-stage-icon={s.id}>
                  <Glyph name={s.icon} />
                </span>
              ))
            }
            <span class="s-icon show" data-stage-icon="none"><Glyph name="dice-five" /></span>
          </span>
          <div class="stage-text">
            <strong data-stage-title>Mystery sound</strong>
            <span data-stage-sub>Every roll is a surprise</span>
          </div>
          <canvas class="wave" data-wave aria-hidden="true"></canvas>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section.roll-section {
    padding-bottom: clamp(32px, 4.5vw, 56px);
  }

  .roll-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
  }

  /* MARK: Dice */

  .dice-side {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .big-dice {
    --s: clamp(120px, 14vw, 168px);
    position: relative;
    width: calc(var(--s) * 2);
    height: calc(var(--s) * 2.1);
    display: grid;
    place-items: center;
    perspective: 900px;
    border-radius: 32px;
    -webkit-tap-highlight-color: transparent;
  }

  .big-dice:focus-visible {
    outline-offset: -8px;
  }

  .dice-hop {
    display: block;
    transform-style: preserve-3d;
    animation: dice-float 3.2s ease-in-out infinite;
  }

  .big-dice.is-rolling .dice-hop,
  .big-dice.is-used .dice-hop {
    animation: none;
  }

  @keyframes dice-float {
    50% {
      translate: 0 -10px;
    }
  }

  .big-dice.nudge .dice-tilt {
    animation: nudge-dice 0.7s var(--spring);
  }

  @keyframes nudge-dice {
    30% {
      rotate: -8deg;
    }
    60% {
      rotate: 6deg;
    }
  }

  .dice-tilt {
    display: block;
    transform-style: preserve-3d;
    transform: rotateX(-24deg) rotateY(32deg);
    transition: transform 0.6s var(--spring);
  }

  .big-dice:hover:not(.is-rolling) .dice-tilt {
    transform: rotateX(-30deg) rotateY(40deg) scale(1.04);
  }

  .dice {
    position: relative;
    display: block;
    width: var(--s);
    height: var(--s);
    transform-style: preserve-3d;
  }

  .face,
  .core {
    position: absolute;
    inset: 0;
    border-radius: 22%;
  }

  .face {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    padding: 16%;
    gap: 4%;
    background: linear-gradient(145deg, #fffaf0, #ffe39a 45%, #ffc247);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.5),
      inset -6px -8px 18px rgb(194 120 20 / 0.35),
      inset 6px 6px 14px rgb(255 255 255 / 0.6);
    backface-visibility: hidden;
  }

  .face i {
    border-radius: 50%;
  }

  .face i.on {
    background: radial-gradient(circle at 40% 35%, #5a3a10, #241500 70%);
    box-shadow: inset 0 2px 3px rgb(0 0 0 / 0.5), 0 1px 0 rgb(255 255 255 / 0.6);
  }

  /* An inner cube so the rounded corners never show gaps */
  .core {
    background: #e7a83a;
    border-radius: 12%;
  }

  .face-front { transform: translateZ(calc(var(--s) / 2)); }
  .face-back { transform: rotateY(180deg) translateZ(calc(var(--s) / 2)); }
  .face-right { transform: rotateY(90deg) translateZ(calc(var(--s) / 2)); }
  .face-left { transform: rotateY(-90deg) translateZ(calc(var(--s) / 2)); }
  .face-top { transform: rotateX(90deg) translateZ(calc(var(--s) / 2)); }
  .face-bottom { transform: rotateX(-90deg) translateZ(calc(var(--s) / 2)); }
  .core-front { transform: translateZ(calc(var(--s) / 2 - 3px)); }
  .core-back { transform: rotateY(180deg) translateZ(calc(var(--s) / 2 - 3px)); }
  .core-right { transform: rotateY(90deg) translateZ(calc(var(--s) / 2 - 3px)); }
  .core-left { transform: rotateY(-90deg) translateZ(calc(var(--s) / 2 - 3px)); }
  .core-top { transform: rotateX(90deg) translateZ(calc(var(--s) / 2 - 3px)); }
  .core-bottom { transform: rotateX(-90deg) translateZ(calc(var(--s) / 2 - 3px)); }

  .dice-shadow {
    position: absolute;
    left: 50%;
    bottom: 6%;
    width: calc(var(--s) * 1.1);
    height: calc(var(--s) * 0.18);
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 194 71 / 0.35), rgb(255 160 40 / 0.08) 60%, transparent);
    pointer-events: none;
  }

  .dice-cta {
    margin: 4px 0 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-2);
    transition: opacity 0.3s;
  }

  .found {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .found-dots {
    display: grid;
    grid-template-columns: repeat(11, 10px);
    gap: 7px;
  }

  .found-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--fill-strong);
    transition: background-color 0.3s, transform 0.5s var(--spring), box-shadow 0.3s;
  }

  .found-dots i.on {
    background: var(--tint);
    box-shadow: 0 0 10px color-mix(in srgb, var(--tint) 60%, transparent);
  }

  .found-dots i.just {
    transform: scale(1.8);
  }

  .found-text {
    font-size: 13px;
    color: var(--text-3);
  }

  .found-text b {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  /* MARK: Stage */

  .stage-card {
    border-radius: var(--r-lg);
    padding: 16px;
    background: #0d0d0f;
    box-shadow: 0 0 0 1px var(--stroke) inset, 0 40px 100px -40px color-mix(in srgb, var(--tint) 35%, transparent);
    transition: box-shadow 0.6s;
  }

  .stage-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 32px;
    padding: 0 4px 12px;
  }

  .chip {
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--tint);
    background: color-mix(in srgb, var(--tint) 14%, transparent);
    transition: color 0.3s, background-color 0.3s;
  }

  .replay {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
    background: rgb(255 255 255 / 0.06);
    transition: color 0.2s, background-color 0.2s, transform 0.3s var(--spring);
  }

  .replay[hidden] {
    display: none;
  }

  .replay:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.1);
  }

  .replay:active {
    transform: scale(0.94);
  }

  .replay :global(svg) {
    width: 14px;
    height: 14px;
  }

  .stage-area {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    overflow: hidden;
    background:
      radial-gradient(70% 70% at 50% 60%, color-mix(in srgb, var(--tint) 16%, transparent), transparent 70%),
      #121215;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05);
    transition: background-color 0.4s;
  }

  .scene {
    position: absolute;
    inset: 0;
    container-type: size;
  }

  .idle {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-3);
    text-align: center;
    transition: opacity 0.3s;
  }

  .idle p {
    margin: 0;
    font-size: 15px;
  }

  .idle-arrow {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.06);
    animation: point-left 1.4s ease-in-out infinite;
  }

  .idle-arrow :global(svg) {
    width: 20px;
    height: 20px;
  }

  @keyframes point-left {
    50% {
      translate: -6px 0;
    }
  }

  @keyframes point-up {
    50% {
      translate: 0 -6px;
    }
  }

  .idle.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .stage-bottom {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 6px 4px;
  }

  .s-icon {
    display: none;
    width: 58%;
    height: 58%;
  }

  .s-icon.show {
    display: grid;
  }

  .s-icon :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 2.3;
  }

  .stage-badge.pop {
    animation: badge-pop 0.5s var(--spring);
  }

  @keyframes badge-pop {
    from {
      transform: scale(0.4);
    }
  }

  .stage-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .stage-text strong {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .stage-text span {
    font-size: 13px;
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wave {
    flex: 1;
    min-width: 80px;
    height: 40px;
  }

  @media (max-width: 860px) {
    .roll-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .big-dice {
      --s: 116px;
    }

    /* The dice sits above the stage when stacked, so the arrow points up at it */
    .idle-arrow {
      animation-name: point-up;
    }

    .idle-arrow :global(svg) {
      rotate: 90deg;
    }
  }

  @media (max-width: 520px) {
    .wave {
      display: none;
    }
  }
</style>

<!-- Styles for the scene elements, which are created by script. -->
<style is:global>
  .dice-stage > div {
    position: absolute;
  }

  .dice-stage .sc-ring {
    translate: -50% -50%;
    border: 0.6cqw solid;
    border-radius: 50%;
  }

  .dice-stage .sc-star {
    width: 2.6cqw;
    height: 2.6cqw;
    translate: -50% -50%;
    background: var(--tint);
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
  }

  .dice-stage .sc-note {
    translate: -50% -50%;
    font-size: 6cqw;
    font-weight: 700;
    color: var(--tint);
  }

  /* Shop */
  .dice-stage .sc-shop {
    left: 50%;
    top: 16%;
    width: 54cqw;
    height: 70%;
    translate: -50% 0;
  }

  .dice-stage .sc-awning {
    position: absolute;
    left: -4%;
    right: -4%;
    top: 0;
    height: 18%;
    border-radius: 1.4cqw 1.4cqw 3cqw 3cqw;
    background: repeating-linear-gradient(90deg, var(--tint) 0 12.5%, #fff6e3 12.5% 25%);
    box-shadow: 0 1.4cqw 2cqw rgb(0 0 0 / 0.35);
    z-index: 2;
  }

  .dice-stage .sc-roof {
    position: absolute;
    left: -8%;
    right: -8%;
    top: -18%;
    height: 36%;
    background: var(--tint);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    z-index: 2;
  }

  .dice-stage .sc-door {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 14%;
    bottom: 0;
    overflow: hidden;
    border-radius: 0.8cqw 0.8cqw 0 0;
    background: #1d1d21;
    box-shadow: 0 0 0 0.8cqw #2c2c31;
  }

  .dice-stage .sc-inside {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: radial-gradient(80% 90% at 50% 100%, #ffc247, #ff9a2e 50%, #3a2408);
  }

  .dice-stage .sc-open {
    padding: 1cqw 2.6cqw;
    border-radius: 1cqw;
    font-family: var(--font-display);
    font-size: 5cqw;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--rust);
    background: #fff6e3;
    box-shadow: 0 1cqw 2cqw rgb(0 0 0 / 0.3);
  }

  .dice-stage .sc-slats {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(180deg, #8a8a92 0, #9e9ea6 1.2cqw, #6a6a72 2.6cqw, #4c4c53 3cqw);
  }

  .dice-stage .sc-handle {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.4cqw;
    background: var(--rust);
  }

  /* Bell, moon */
  .dice-stage .sc-rope {
    left: 50%;
    top: 0;
    width: 0.6cqw;
    height: 22%;
    translate: -50% 0;
    background: #555;
  }

  .dice-stage .sc-bell {
    left: 50%;
    top: 20%;
    width: 22cqw;
    height: 22cqw;
    translate: -50% 0;
    transform-origin: 50% 0;
    border-radius: 50% 50% 14% 14% / 70% 70% 14% 14%;
    background: linear-gradient(160deg, #fff3c4, var(--tint) 55%, #b77a12);
    box-shadow: 0 2cqw 4cqw rgb(0 0 0 / 0.4);
  }

  .dice-stage .sc-clapper {
    position: absolute;
    left: 50%;
    bottom: -3cqw;
    width: 5cqw;
    height: 5cqw;
    translate: -50% 0;
    border-radius: 50%;
    background: #8a5a10;
  }

  .dice-stage .sc-moon {
    left: 46%;
    top: 45%;
    width: 22cqw;
    height: 22cqw;
    translate: -50% -50%;
    border-radius: 50%;
    box-shadow: inset 4cqw -2cqw 0 0 var(--tint);
  }

  .dice-stage .sc-twinkle {
    width: 1.6cqw;
    height: 1.6cqw;
    background: #fff;
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
  }

  .dice-stage .sc-z {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 6cqw;
    color: var(--tint);
  }

  /* Pops */
  .dice-stage .sc-popper {
    left: 50%;
    top: 70%;
    width: 12cqw;
    height: 16cqw;
    translate: -50% 0;
    background: linear-gradient(90deg, var(--tint), #fff 50%, var(--tint));
    clip-path: polygon(50% 100%, 0 0, 100% 0);
  }

  .dice-stage .sc-confetti {
    width: 1.8cqw;
    height: 1cqw;
    border-radius: 0.3cqw;
  }

  .dice-stage .sc-streak {
    left: 50%;
    top: 20%;
    width: 1cqw;
    height: 48%;
    translate: -50% 0;
    transform-origin: 50% 100%;
    border-radius: 1cqw;
    background: linear-gradient(0deg, var(--tint), transparent);
  }

  .dice-stage .sc-bar {
    bottom: 14%;
    width: 10cqw;
    translate: -50% 0;
    border-radius: 1.4cqw;
    background: linear-gradient(180deg, color-mix(in srgb, var(--tint) 60%, #fff), var(--tint));
  }

  .dice-stage .sc-bigstar {
    left: 50%;
    top: 30%;
    width: 18cqw;
    height: 18cqw;
    translate: -50% -50%;
    background: linear-gradient(160deg, #fff6cc, #ffc247);
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }

  .dice-stage .sc-lap {
    left: 50%;
    top: 62%;
    width: 40cqw;
    translate: -50% 0;
  }

  .dice-stage .sc-lid,
  .dice-stage .sc-base {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2.4cqw;
    border-radius: 2cqw;
    background: #f5f5f7;
  }

  .dice-stage .sc-lid {
    top: -2.6cqw;
    left: 4%;
    width: 92%;
    transform-origin: 0 50%;
    background: linear-gradient(90deg, #f5f5f7, color-mix(in srgb, var(--tint) 50%, #fff));
  }

  .dice-stage .sc-pop {
    left: 50%;
    top: 58%;
    width: 30cqw;
    height: 30cqw;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--tint) 70%, transparent), transparent);
  }

  /* Bouncy */
  .dice-stage .sc-spring {
    left: 50%;
    bottom: 12%;
    width: 12cqw;
    height: 16cqw;
    translate: -50% 0;
    transform-origin: 50% 100%;
    background: repeating-linear-gradient(170deg, transparent 0 1.4cqw, #c9c9d0 1.4cqw 2.4cqw);
  }

  .dice-stage .sc-ball {
    left: 50%;
    bottom: calc(12% + 16cqw);
    width: 14cqw;
    height: 14cqw;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, var(--tint) 45%, color-mix(in srgb, var(--tint) 60%, #000));
  }

  .dice-stage .sc-duck {
    left: 44%;
    top: 34%;
    width: 30cqw;
    height: 26cqw;
    translate: -50% 0;
    transform-origin: 50% 100%;
  }

  .dice-stage .sc-duck > div {
    position: absolute;
  }

  .dice-stage .sc-duck-body {
    left: 0;
    bottom: 0;
    width: 100%;
    height: 62%;
    border-radius: 50% 50% 46% 46%;
    background: radial-gradient(circle at 40% 30%, #fff6b0, #ffd23f 60%, #e0a800);
  }

  .dice-stage .sc-duck-head {
    right: 6%;
    top: 0;
    width: 44%;
    height: 54%;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 30%, #fff6b0, #ffd23f 60%, #e0a800);
  }

  .dice-stage .sc-duck-eye {
    position: absolute;
    left: 56%;
    top: 34%;
    width: 14%;
    height: 16%;
    border-radius: 50%;
    background: #1a1a1a;
  }

  .dice-stage .sc-duck-beak {
    position: absolute;
    right: -26%;
    top: 46%;
    width: 36%;
    height: 22%;
    border-radius: 50% 60% 60% 40%;
    background: #ff8a3d;
  }

  .dice-stage .sc-duck-wing {
    left: 14%;
    top: 46%;
    width: 36%;
    height: 30%;
    transform-origin: 80% 30%;
    border-radius: 60% 40% 60% 40%;
    background: #f2b800;
  }

  .dice-stage .sc-bubble-text {
    translate: -50% -50%;
    padding: 0.8cqw 2cqw;
    border-radius: 2cqw;
    font-size: 3.4cqw;
