---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { jsonLd, ogImage } from '../lib/seo';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  noindex?: boolean;
  /** Structured data (JSON-LD) for this page. */
  schema?: object[];
}

const { title, description = site.metaDescription, home = true, noindex = false, schema = [] } = Astro.props;
const fullTitle = title ? `${title} · LidShutter` : site.homeTitle;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      )
    }
    <meta name="author" content="LidShutter" />
    <meta name="application-name" content="LidShutter" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LidShutter in plain text, for AI assistants" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LidShutter" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LidShutter: a Mac menu bar app that plays a shop shutter when you open your MacBook lid" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {schema.map((item) => <script type="application/ld+json" set:html={jsonLd(item)} />)}

    {import.meta.env.PROD && (
      <>
        <!-- Google tag (gtag.js) -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-K5812ZWKQ8"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-K5812ZWKQ8');
        </script>

        <!-- DataFast -->
        <script is:inline defer data-website-id="dfid_s32MgUe709d4iFfVo1B94" data-domain="lidshutter.com" src="https://datafa.st/js/script.js"></script>
      </>
    )}
    <Analytics />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Nav home={home} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      .skip {
        position: absolute;
        left: 16px;
        top: -48px;
        z-index: 100;
        padding: 8px 14px;
        border-radius: 8px;
        background: var(--gold);
        color: var(--on-gold);
        font-weight: 600;
      }

      .skip:focus {
        top: 12px;
      }
    </style>

    <script>
      import '../scripts/smooth';

      // Decode images quietly after load, so none of them is decoded mid-scroll.
      const warm = () => document.querySelectorAll('img').forEach((img) => img.decode?.().catch(() => {}));
      if ('requestIdleCallback' in window) requestIdleCallback(warm, { timeout: 2000 });
      else setTimeout(warm, 1200);

      // Fade sections in as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Pointer-following light on cards and tiles.
      document.querySelectorAll<HTMLElement>('.card, .tile').forEach((el) => el.classList.add('spot'));
      document.addEventListener(
        'pointermove',
        (e) => {
          const el = (e.target as Element).closest('.spot') as HTMLElement | null;
          if (!el) return;
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        },
        { passive: true },
      );
    </script>
  </body>
</html>
